# Server ports
HTTP_PORT=8001
GRPC_PORT=50051

# Database
DATABASE_URL=postgres://postgres:postgres_secret_pass@localhost:5432/identity_db

# Redis
REDIS_URL=redis://:redis_secret_pass@localhost:6379/0

# Kafka / Redpanda
KAFKA_BROKERS=localhost:9092
KAFKA_IDENTITY_TOPIC=identity.events

# Security
JWT_SECRET=super_secret_jwt_hmac_key_min_32_bytes_long_here_12345
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
PASSWORD_RESET_TOKEN_TTL_SECONDS=900

# Tracing
RUST_LOG=info,identity_service=debug
