# Server ports
HTTP_PORT=8001
GRPC_PORT=50051

# Database (host: localhost:5432, docker: postgres:5432)
DATABASE_URL=postgres://postgres:postgres_secret_pass@postgres:5432/identity_db

# Redis (host: localhost:6379/0, docker: redis:6379/0)
REDIS_URL=redis://:redis_secret_pass@redis:6379/0

# Kafka / Redpanda (host: localhost:9092, docker: redpanda:29092)
KAFKA_BROKERS=redpanda:29092
KAFKA_IDENTITY_TOPIC=identity.events

# Security & OIDC
JWT_SECRET=super_secret_jwt_hmac_key_min_32_bytes_long_here_12345
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
PASSWORD_RESET_TOKEN_TTL_SECONDS=900
OAUTH_ISSUER=http://localhost

# Tracing & Logging
RUST_LOG=info,identity_service=debug
