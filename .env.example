# Canonical identity owner .env; never commit real values. Empty required keys fail closed.
DATABASE_URL=postgres://identity_runtime:@postgres:5432/identity_db?sslmode=verify-full&sslrootcert=/run/tls/ca.crt
HTTP_PORT=8001
PUBLIC_ORIGIN=https://localhost:8448
OAUTH_ISSUER=https://localhost:8448
TLS_CERT_FILE=/run/tls/tls.crt
TLS_KEY_FILE=/run/tls/tls.key
INTERNAL_CA_FILE=/run/tls/ca.crt
SIGNING_KEY_FILE=/run/signing/private.pem
SIGNING_KID=identity-local-2026-10
# PREVIOUS_SIGNING_PUBLIC_KEY_FILE=/run/signing/previous-public.pem
# PREVIOUS_SIGNING_KID=identity-previous
MFA_ENCRYPTION_KEY=
DELIVERY_ENCRYPTION_KEY=
PROFILE_INTERNAL_TOKEN=
NOTIFICATION_INTERNAL_TOKEN=
ADMIN_INTERNAL_TOKEN=
GATEWAY_INTERNAL_TOKEN=
KAFKA_BROKERS=redpanda:29092
KAFKA_TLS_CA_FILE=/run/tls/ca.crt
KAFKA_SASL_USERNAME=identity
KAFKA_SASL_PASSWORD=
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=identity-service
RUST_LOG=info
# Canonical orchestration credentials; admin password is never mounted into server pods.
IDENTITY_TOKEN=
IDENTITY_RUNTIME_PASSWORD=
IDENTITY_MIGRATION_PASSWORD=
KAFKA_IDENTITY_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Legacy ENCRYPTION_KEY exists only during explicit maintenance rekey; never generate it.
# ENCRYPTION_KEY=
# Private bytes use JSON-compatible double-quoted strings with escaped newlines.
SIGNING_PRIVATE_KEY=
IDENTITY_SERVICE_TLS_PRIVATE_KEY=
